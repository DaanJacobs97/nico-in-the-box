{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run application on macOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "macos"
    },
    {
      "name": "Run application on Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "Nico in the Box (macOS profile + tactical perf log)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define=TACTICAL_PERF_LOG=true"]
    }
  ]
}
